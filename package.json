{
  "name": "@zythum02/pptxgenjsx",
  "version": "0.1.6",
  "description": "JSX runtime for building PowerPoint presentations with pptxgenjs",
  "homepage": "https://github.com/zythum/pptxgenjsx#readme",
  "bugs": {
    "url": "https://github.com/zythum/pptxgenjsx/issues"
  },
  "license": "MIT",
  "author": {
    "name": "zythum",
    "email": "zythum02@gmail.com",
    "url": "https://github.com/zythum"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zythum/pptxgenjsx.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./render": {
      "types": "./dist/render.d.ts",
      "default": "./dist/render.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt"
  },
  "dependencies": {
    "pptxgenjs": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "typescript": "^7.0.0"
  }
}
